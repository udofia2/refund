# --- LLM Provider ---
# No LLM_API_KEY set -> the app runs on the built-in deterministic mock provider.
LLM_PROVIDER=gemini                    # gemini | openai | anthropic (ignored while LLM_API_KEY is empty)
LLM_MODEL=gemini-2.0-flash             # model name passed to the provider SDK
LLM_API_KEY=your-key-here              # leave empty/unset to stay on the mock provider
LLM_TEMPERATURE=0.1                    # generation temperature
LLM_MAX_TOKENS=1024                    # max response tokens
LLM_TIMEOUT_SECONDS=20                 # per-request SDK timeout

# --- Application ---
APP_ENV=development                    # development | production (informational)
LOG_LEVEL=INFO                         # python logging level
# NOTE: docker-compose.yml's `environment:` block overrides this for the container
# (sqlite:////app/data/refunds.db on the named `refund-db` volume). To change the
# database path under Docker, edit the compose file — not this value.
DATABASE_URL=sqlite:///./data/refunds.db

# --- Rate Limiting ---
# 10 requests / 60s / IP on POST /api/refund-requests, keyed by first X-Forwarded-For
# entry (else peer address). State is in-memory per backend process: it survives DB
# resets but clears on `docker compose restart backend`.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10                 # per window
RATE_LIMIT_WINDOW_SECONDS=60

# --- Policy ---
REFUND_MAX_DAYS=30                     # order age limit; older orders denied (ORDER_TOO_OLD)
REFUND_HIGH_VALUE_THRESHOLD=500.00     # strictly greater than this -> escalate (HIGH_VALUE)
REFUND_DUPLICATE_WINDOW_HOURS=24       # lookback window for DUPLICATE_RECENT
REFUND_DUPLICATE_RECENT_THRESHOLD=3    # requests in window before escalating

# --- CORS (JSON list; CORS_ORIGINS) ---
# Allowed browser origins for the API. Must match the origin serving the UI.
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000   # docker compose build arg for the UI's API base
